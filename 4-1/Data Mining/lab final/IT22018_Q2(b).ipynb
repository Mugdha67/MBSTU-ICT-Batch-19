      "source": [
        "import numpy as np\n",
        "import skfuzzy as fuzz\n",
        "\n",
        "X = np.array([[2,3,4,9,10,11]])\n",
        "cntr, u, _, _, _, _, _ = fuzz.cluster.cmeans(\n",
        "    X,\n",
        "    c=2,\n",
        "    m=2,\n",
        "    error=0.005,\n",
        "    maxiter=1000\n",
        ")\n",
        "\n",
        "print(\"Centers:\", cntr)\n",
        "print(\"Membership:\\n\", u)"
      ]
    },
